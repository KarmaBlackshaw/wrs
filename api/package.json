{
  "name": "wrs-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node src/server.ts",
    "type-check": "tsc",
    "lint": "eslint . --max-warnings=0 --fix",
    "format": "prettier --write .",
    "knex": "node --env-file-if-exists=.env \"$(node -p \"require.resolve('knex/bin/cli.js')\")\"",
    "migrate:make": "npm run knex -- migrate:make -x ts",
    "migrate": "npm run knex -- migrate:latest",
    "migrate:rollback": "npm run knex -- migrate:rollback",
    "seed:make": "npm run knex -- seed:make -x ts",
    "seed": "npm run knex -- seed:run",
    "test": "vitest",
    "serve": "docker compose up -d --wait db && npm run migrate && npm run dev",
    "preserve": "docker info >/dev/null 2>&1 || (echo 'Docker is not running. Start Docker Desktop, then retry.' >&2 && exit 1)",
    "db:scratch": "node --env-file-if-exists=.env scripts/db-scratch.ts",
    "db:scratch:drop": "node --env-file-if-exists=.env scripts/db-scratch-drop.ts",
    "db:reset": "npm run knex -- migrate:rollback --all && npm run migrate && npm run seed"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --max-warnings=0 --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "**/*.{json,md}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/sensible": "^6.0.6",
    "@wrs/contract": "*",
    "argon2": "^0.45.1",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5",
    "fastify-type-provider-zod": "^7.0.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
